{
  "schemaVersion": 1,
  "id": "hexic",
  "version": "${version}",
  "name": "Hexic",
  "description": "Utilities and helpers for my Hex Casting addons.",
  "authors": [],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/hexic/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.eu.net.pool.hexic.client.HexicClient\u0024package::datagen"
    ],
    "client": [
      "org.eu.net.pool.hexic.client.HexicClient\u0024package::init"
    ],
    "main": [
      "org.eu.net.pool.hexic.Hexic\u0024package::init"
    ],
    "mm:early_risers": [
      "org.eu.net.pool.hexic.EarlyRiser\u0024package::warCrimes"
    ]
  },
  "mixins": [
    "hexic.mixins.json",
    {
      "config": "hexic.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-scala": ">=${scala_loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
